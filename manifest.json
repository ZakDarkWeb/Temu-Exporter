{
  "manifest_version": 3,
  "name": "Temu Order Exporter",
  "version": "3.0.0",
  "description": "Polished local Temu Seller order extraction with resilient recovery, diagnostics, and accessible responsive UI.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://seller.temu.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller.temu.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "xlsx.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Temu Order Exporter 3.0",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
